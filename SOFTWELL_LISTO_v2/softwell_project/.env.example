# =============================================
# Copia este archivo como .env y completa los valores
# NUNCA subas el .env a GitHub
# =============================================

# URI de conexion a MongoDB Atlas
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://TU_USUARIO:TU_PASSWORD@TU_CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos (por defecto: softwell)
MONGODB_DATABASE=softwell

# Configuracion SMTP (ejemplo para Gmail; usar una contraseña de aplicacion)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-contrasena-de-aplicacion

# Credenciales de Cloudinary
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret
